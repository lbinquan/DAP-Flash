<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- 可选：手动指定 probe-rs.exe 的完整路径。留空时依次查找：环境变量 PROBE_RS_PATH、
             程序目录及其上层的 tools 目录、当前目录及其上层的 tools 目录、PATH、%USERPROFILE%\.cargo\bin。 -->
        <add key="ProbeRsPath" value="" />
    </appSettings>
</configuration>
